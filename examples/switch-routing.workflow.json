        "port": "main",
        "index": 1
      },
      "to": {
        "node": "Queue for later",
        "port": "main",
        "index": 0
      }
    },
    {
      "from": {
        "node": "By priority",
        "port": "main",
        "index": 8
      },
      "to": {
        "node": "Triage by hand",
        "port": "main",
        "index": 0
      }
    },
    {
      "from": {
        "node": "Page on-call",
        "port": "main",
        "index": 0
      },
      "to": {
